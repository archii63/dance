## Core Implementation

```python
# pulseforge/checker.py

from __future__ import annotations

import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import asdict, dataclass
from typing import Iterable

import requests


@dataclass
class CheckResult:
    name: str
    url: str
    status_code: int | None
    latency_ms: float | None
    healthy: bool
    error: str | None = None


def check_endpoint(endpoint: dict, timeout: float) -> CheckResult:
    name = endpoint["name"]
    url = endpoint["url"]

    start = time.perf_counter()

    try:
        response = requests.get(
            url,
            timeout=timeout,
            headers={"User-Agent": "PulseForge/1.0"},
        )

        latency = (time.perf_counter() - start) * 1000

        return CheckResult(
            name=name,
            url=url,
            status_code=response.status_code,
            latency_ms=round(latency, 2),
            healthy=200 <= response.status_code < 400,
        )

    except requests.RequestException as exc:
        return CheckResult(
            name=name,
            url=url,
            status_code=None,
            latency_ms=None,
            healthy=False,
            error=str(exc),
        )


def run_checks(
    endpoints: Iterable[dict],
    timeout: float = 5,
    workers: int = 8,
) -> list[dict]:

    results = []

    with ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [
            executor.submit(check_endpoint, endpoint, timeout)
            for endpoint in endpoints
        ]

        for future in as_completed(futures):
            results.append(asdict(future.result()))

    return results
```

### CLI

```python
# pulseforge/cli.py

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from .checker import run_checks


def main() -> None:
    parser = argparse.ArgumentParser(
        description="PulseForge API health monitor"
    )

    parser.add_argument(
        "config",
        type=Path,
        help="Path to configuration JSON file",
    )

    parser.add_argument(
        "--output",
        type=Path,
        default=Path("pulseforge-report.json"),
        help="Output report path",
    )

    args = parser.parse_args()

    with args.config.open("r", encoding="utf-8") as file:
        config = json.load(file)

    results = run_checks(
        endpoints=config["endpoints"],
        timeout=config.get("timeout", 5),
        workers=config.get("workers", 8),
    )

    report = {
        "total": len(results),
        "healthy": sum(item["healthy"] for item in results),
        "failed": sum(not item["healthy"] for item in results),
        "results": results,
    }

    with args.output.open("w", encoding="utf-8") as file:
        json.dump(report, file, indent=2)

    for result in results:
        status = "UP" if result["healthy"] else "DOWN"

        latency = (
            f'{result["latency_ms"]} ms'
            if result["latency_ms"] is not None
            else "N/A"
        )

        print(
            f'[{status}] {result["name"]} '
            f'| {result["url"]} | {latency}'
        )

    if report["failed"] > 0:
        sys.exit(1)


if __name__ == "__main__":
    main()
```

